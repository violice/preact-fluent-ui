{
  "name": "@violice/preact-fluent-ui",
  "version": "0.6.0",
  "description": "Preact components and explicit Fluent-style CSS for desktop web applications",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/violice/preact-fluent-ui.git"
  },
  "exports": {
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "import": "./dist/styles.js"
    },
    "./config": {
      "types": "./dist/styles/config/index.d.ts",
      "import": "./dist/config.js"
    },
    "./vite": {
      "types": "./dist/styles/adapters/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "licenses",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "tokens:generate": "node scripts/generate-token-references.mjs",
    "tokens:check": "node scripts/generate-token-references.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts tests/package-consumer examples/gallery vite.config.ts vitest.config.ts --max-warnings 0",
    "format": "oxfmt --write src scripts tests/package-consumer examples/gallery vite.config.ts vitest.config.ts tsconfig.json tsconfig.build.json package.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src scripts tests/package-consumer examples/gallery vite.config.ts vitest.config.ts tsconfig.json tsconfig.build.json package.json .oxlintrc.json .oxfmtrc.json",
    "test": "vitest run",
    "test:release": "node --test scripts/check-release.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:package-guards": "node --test scripts/runtime-imports.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "build": "npm run tokens:generate && vite build && tsc -p tsconfig.build.json && node scripts/build-css.mjs && node scripts/check-dist.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "dev": "npm run build && vite --config examples/gallery/vite.config.ts",
    "build:gallery": "vite build --config examples/gallery/vite.config.ts && npm run check:gallery",
    "check": "npm run tokens:check && npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:release && npm run test:package-guards && npm run licenses:check",
    "test:package:all": "node scripts/test-package-all.mjs",
    "check:gallery": "node scripts/check-gallery.mjs",
    "test:gallery-artifact": "node --test scripts/check-gallery.test.mjs",
    "test:gallery-preview": "node --test scripts/gallery-preview.test.mjs",
    "test:styles-package": "node scripts/test-styles-package.mjs"
  },
  "peerDependencies": {
    "preact": "^10.27.0",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@preact/signals": "^2.11.3",
    "@tanstack/highlight": "1.0.0",
    "@tanstack/markdown": "1.0.0",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "preact": "^10.27.0",
    "preact-iso": "^2.12.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@wyw-in-js/processor-utils": "2.5.0",
    "@wyw-in-js/vite": "2.5.1",
    "magic-string": "0.30.21",
    "oxc-parser": "0.131.0"
  }
}
